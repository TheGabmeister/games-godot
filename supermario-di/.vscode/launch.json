{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Godot Game",
            "type": "coreclr",
            "request": "launch",
            "program": "${config:godotTools.editorPath.godot4}",
            "args": [
                "--path",
                "${workspaceFolder}"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "Attach to Godot C#",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
